# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.

# ---- Desenvolvimento (python manage.py runserver) ----
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Sem DB_NAME, o projeto usa SQLite (db.sqlite3).

# ---- Servidor (docker compose) ----
# Com DB_NAME preenchido, o projeto usa PostgreSQL. DEBUG é sempre False dentro do container.
# Gere senhas com: openssl rand -hex 24
# APP_PORT=porta-local-reservada-no-servidor
# ALLOWED_HOSTS=endereco-do-site,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://endereco-do-site
# POSTGRES_PASSWORD=
# DB_NAME=sustentagro
# DB_USER=sustentagro_app
# DB_PASSWORD=

# Superusuário criado por: docker compose exec app python create_user.py
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha
