# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco: sem DB_NAME, o projeto usa SQLite (db.sqlite3). Na VPS, preencha para usar PostgreSQL.
# DB_NAME=sustentagro
# DB_USER=sustentagro_app
# DB_PASSWORD=
# DB_HOST=db
# DB_PORT=5432

# Produção (só na VPS)
# CSRF_TRUSTED_ORIGINS=https://endereco-do-site

# Superusuário criado por create_user.py
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha
